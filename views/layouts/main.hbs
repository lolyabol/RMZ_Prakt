<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Аналитика печати РМЗ</title>
  <link rel="stylesheet" href="/public/css/main.css?v={{currentTime}}">
  <link rel="stylesheet" href="/public/css/index.css?v={{currentTime}}">
  <link rel="stylesheet" href="/public/css/filteredEntries.css?v={{currentTime}}">
  <link rel="stylesheet" href="/public/css/debug.css?v={{currentTime}}">
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>
  <div class="wrapper">
    <header class="header">
        <div class="header-content">
          <a href="/reports" class="logo">
            <img src="https://pic.rutubelist.ru/user/fb/8b/fb8bc989c64c6a630f016347db72c9be.jpg" alt="PrintAnalytics Logo" class="logo-img" />
            <span class="logo-text">Филиал АО «Курганмашзавод» - Рубцовск. Аналитика печати</span>
          </a>
        </div>
    </header>

    <main class="main-content">
      <div class="container">
        {{#if error}}
          <div class="alert error">{{error}}</div>
        {{/if}}

        {{{body}}}
      </div>
    </main>

    <footer class="footer">
      <div class="container">
        <p>Аналитика печати &copy; {{currentYear}}</p>
      </div>
    </footer>
  </div> <!-- закрываем wrapper -->
</body>
</html>